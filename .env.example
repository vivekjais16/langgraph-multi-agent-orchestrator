# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Configuration (Optional for Mock/Local Execution)
OPENAI_API_KEY=sk-mock-key-development
OPENAI_MODEL=gpt-4-turbo
TEMPERATURE=0.2

# Persistence & Checkpointing
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Model Context Protocol (MCP) Server Transports
MCP_SERVER_URL=http://localhost:8001/sse
MCP_TIMEOUT_SECONDS=15.0

# Human-in-the-loop & Safety Thresholds
CRITIC_PASS_THRESHOLD=0.85
MAX_CORRECTION_CYCLES=3
